---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, getCategoryBySlug } from '../../data/categories';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const activeSlugs = new Set(allPosts.map(p => p.data.category));

  return categories
    .filter(cat => activeSlugs.has(cat.slug))
    .map(cat => ({
      params: { category: cat.slug },
      props: {
        categoryData: cat,
        posts: allPosts
          .filter(p => p.data.category === cat.slug)
          .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      },
    }));
}

const { categoryData, posts } = Astro.props;

const breadcrumbs = [
  { label: 'Blog', href: '/blog/' },
  { label: categoryData.name },
];
---

<PageLayout
  title={`${categoryData.name} — Market Matters Online`}
  description={categoryData.description}
  breadcrumbs={breadcrumbs}
>
  <div class="site-container section-pad">
    <div class="flex items-center gap-4 mb-8">
      <span class="text-5xl" role="img" aria-label={categoryData.name}>{categoryData.icon}</span>
      <div>
        <h1 class="text-4xl font-bold text-slate-900">{categoryData.name}</h1>
        <p class="text-lg text-slate-600 mt-1">{categoryData.description}</p>
      </div>
    </div>

    <div class="flex items-center justify-between mb-6 pb-6 border-b border-slate-200">
      <p class="text-sm text-slate-500">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>
      <a href="/blog/" class="text-sm text-blue-600 hover:text-blue-700 font-medium">
        ← All categories
      </a>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map(post => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 text-slate-500">
        <p class="text-lg font-medium">No posts in this category yet.</p>
        <p class="mt-2">Check back soon!</p>
      </div>
    )}
  </div>
</PageLayout>
