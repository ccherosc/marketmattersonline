---
import type { CollectionEntry } from 'astro:content';
import { getCategoryName, getCategoryBadgeClass } from '../data/categories';
import { formatDateShort, formatRelativeDate, formatISODate } from '../utils/formatDate';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'default' | 'featured' | 'compact';
}

const { post, variant = 'default' } = Astro.props;
const { title, description, pubDate, category, readTime, heroImage, author } = post.data;
const categoryName = getCategoryName(category);
const badgeClass = getCategoryBadgeClass(category);
const url = `/blog/${post.slug}/`;

// Show relative date for posts under 60 days old, full date otherwise
const displayDate = formatRelativeDate(pubDate);
const authorShort = author.replace('Market Matters Team', 'MMO Team');

const placeholderGradients: Record<string, string> = {
  'marketing-playbook': 'from-blue-600 to-blue-800',
  'ai-automation': 'from-purple-600 to-purple-800',
  'tools-reviews': 'from-emerald-600 to-emerald-800',
  'seo-search': 'from-orange-500 to-orange-700',
  'local-growth-lab': 'from-red-500 to-red-700',
  'templates-downloads': 'from-teal-500 to-teal-700',
  'marketing-news': 'from-slate-600 to-slate-800',
};

const categoryIcons: Record<string, string> = {
  'ai-automation': '🤖',
  'tools-reviews': '🔧',
  'seo-search': '🔍',
  'local-growth-lab': '📍',
  'templates-downloads': '📥',
  'marketing-news': '📰',
  'marketing-playbook': '📋',
};

const gradient = placeholderGradients[category] ?? 'from-slate-600 to-slate-800';
const icon = categoryIcons[category] ?? '📋';
---

{variant === 'featured' ? (
  <article class="card group flex flex-col md:flex-row overflow-hidden">
    <a href={url} class="md:w-2/5 flex-shrink-0 block">
      {heroImage ? (
        <img src={heroImage} alt={title} class="w-full h-48 md:h-full object-cover" loading="lazy" />
      ) : (
        <div class={`w-full h-48 md:h-full bg-gradient-to-br ${gradient} flex items-center justify-center`}>
          <span class="text-white text-4xl opacity-50">{icon}</span>
        </div>
      )}
    </a>
    <div class="p-6 flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <a href={`/category/${category}/`} class={`category-badge ${badgeClass}`}>{categoryName}</a>
          {readTime && <span class="text-xs text-slate-500">{readTime}</span>}
        </div>
        <h2 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors leading-snug">
          <a href={url}>{title}</a>
        </h2>
        <p class="text-slate-600 text-sm line-clamp-3">{description}</p>
      </div>
      <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-100">
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <time datetime={formatISODate(pubDate)}>{displayDate}</time>
          <span class="text-slate-300">·</span>
          <span>{authorShort}</span>
        </div>
        <a href={url} class="text-sm font-medium text-blue-600 hover:text-blue-700">Read more →</a>
      </div>
    </div>
  </article>
) : variant === 'compact' ? (
  <article class="group py-3 border-b border-slate-100 last:border-0">
    <a href={url} class="block">
      <span class={`category-badge ${badgeClass} mb-1 inline-block`}>{categoryName}</span>
      <h3 class="font-semibold text-slate-800 text-sm leading-snug group-hover:text-blue-600 transition-colors mb-1">{title}</h3>
      <div class="flex items-center gap-2 text-xs text-slate-500">
        <time datetime={formatISODate(pubDate)}>{displayDate}</time>
        {readTime && (
          <>
            <span class="text-slate-300">·</span>
            <span>{readTime}</span>
          </>
        )}
      </div>
    </a>
  </article>
) : (
  <article class="card group flex flex-col">
    <a href={url} class="block flex-shrink-0">
      {heroImage ? (
        <img src={heroImage} alt={title} class="w-full h-44 object-cover" loading="lazy" />
      ) : (
        <div class={`w-full h-44 bg-gradient-to-br ${gradient} flex items-center justify-center`}>
          <span class="text-white text-3xl opacity-40">{icon}</span>
        </div>
      )}
    </a>
    <div class="p-5 flex flex-col flex-1">
      <div class="flex items-center gap-2 mb-2">
        <a href={`/category/${category}/`} class={`category-badge ${badgeClass}`}>{categoryName}</a>
        {readTime && <span class="text-xs text-slate-500">{readTime}</span>}
      </div>
      <h2 class="font-bold text-slate-900 mb-2 leading-snug group-hover:text-blue-600 transition-colors">
        <a href={url}>{title}</a>
      </h2>
      <p class="text-sm text-slate-600 line-clamp-2 flex-1">{description}</p>
      <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-100">
        <div class="flex items-center gap-1.5 text-xs text-slate-500">
          <time datetime={formatISODate(pubDate)}>{displayDate}</time>
          <span class="text-slate-300">·</span>
          <span>{authorShort}</span>
        </div>
        <a href={url} class="text-xs font-medium text-blue-600 hover:text-blue-700">Read →</a>
      </div>
    </div>
  </article>
)}
