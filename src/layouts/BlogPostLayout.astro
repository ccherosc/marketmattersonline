---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AffiliateDisclaimer from '../components/AffiliateDisclaimer.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { getCategoryName, getCategoryBadgeClass } from '../data/categories';
import { formatDate, formatRelativeDate, formatISODate } from '../utils/formatDate';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, author, affiliate, heroImage, readTime } = post.data;

const categoryName = getCategoryName(category);
const badgeClass = getCategoryBadgeClass(category);

// Prev / next navigation
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const idx = sorted.findIndex(p => p.slug === post.slug);
const newerPost = idx > 0 ? sorted[idx - 1] : null;
const olderPost = idx < sorted.length - 1 ? sorted[idx + 1] : null;

const breadcrumbs = [
  { label: 'Blog', href: '/blog/' },
  { label: categoryName, href: `/category/${category}/` },
  { label: title },
];
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
  tags={tags}
>
  <ReadingProgress />

  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="site-container py-3">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Article header -->
  <header class="site-container-narrow pt-10 pb-6">
    <div class="flex items-center gap-3 mb-4">
      <a href={`/category/${category}/`} class={`category-badge ${badgeClass}`}>
        {categoryName}
      </a>
      {readTime && (
        <span class="text-sm text-slate-500 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readTime}
        </span>
      )}
    </div>

    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight mb-4 text-balance">
      {title}
    </h1>

    <p class="text-xl text-slate-600 mb-6">{description}</p>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500 pb-6 border-b border-slate-200">
      <a href={`/author/${author.toLowerCase().replace(/\s+/g, '-')}/`} class="flex items-center gap-2 hover:text-blue-600 transition-colors">
        <div class="w-7 h-7 bg-blue-600 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="text-white font-bold text-xs">{author.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}</span>
        </div>
        <strong class="text-slate-700 font-semibold">{author}</strong>
      </a>
      <span class="text-slate-300">·</span>
      <time datetime={formatISODate(pubDate)}>{formatDate(pubDate)}</time>
      {updatedDate && (
        <>
          <span class="text-slate-300">·</span>
          <span>Updated <time datetime={formatISODate(updatedDate)}>{formatDate(updatedDate)}</time></span>
        </>
      )}
    </div>
  </header>

  <!-- Hero image -->
  {heroImage && (
    <div class="site-container-narrow mb-8">
      <img
        src={heroImage}
        alt={title}
        class="w-full aspect-video object-cover rounded-xl"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}

  {affiliate && (
    <div class="site-container-narrow mb-6">
      <AffiliateDisclaimer />
    </div>
  )}

  <!-- Article content -->
  <article class="site-container-narrow pb-10">
    <div class="prose prose-slate prose-lg max-w-none">
      <slot />
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="mt-10 pt-6 border-t border-slate-200">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Filed under</p>
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="text-xs font-medium px-3 py-1.5 bg-slate-100 text-slate-600 rounded-full hover:bg-slate-200 transition-colors cursor-default">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Related posts -->
    <div class="mt-10">
      <RelatedPosts currentSlug={post.slug} category={category} />
    </div>
  </article>

  <!-- Prev / Next navigation -->
  {(newerPost || olderPost) && (
    <nav class="border-t border-slate-200 bg-slate-50" aria-label="Post navigation">
      <div class="site-container-narrow py-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {olderPost && (
            <a
              href={`/blog/${olderPost.slug}/`}
              class="group flex flex-col p-4 rounded-xl border border-slate-200 bg-white hover:border-blue-300 hover:shadow-sm transition-all"
            >
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                Previous post
              </span>
              <span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors text-sm leading-snug">
                {olderPost.data.title}
              </span>
            </a>
          )}
          {newerPost && (
            <a
              href={`/blog/${newerPost.slug}/`}
              class={`group flex flex-col p-4 rounded-xl border border-slate-200 bg-white hover:border-blue-300 hover:shadow-sm transition-all ${!olderPost ? 'sm:col-start-2' : ''}`}
            >
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 flex items-center gap-1 sm:justify-end">
                Next post
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </span>
              <span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors text-sm leading-snug sm:text-right">
                {newerPost.data.title}
              </span>
            </a>
          )}
        </div>
      </div>
    </nav>
  )}

  <!-- Newsletter -->
  <div class="bg-slate-50 border-t border-slate-200">
    <div class="site-container py-12">
      <NewsletterSignup variant="inline" />
    </div>
  </div>

  <!-- Back to top -->
  <button
    id="back-to-top"
    aria-label="Back to top"
    class="fixed bottom-6 right-6 w-10 h-10 bg-slate-900 text-white rounded-full shadow-lg flex items-center justify-center opacity-0 translate-y-2 transition-all duration-200 hover:bg-blue-600 z-50"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <script>
    const btn = document.getElementById('back-to-top');

    window.addEventListener('scroll', () => {
      if (!btn) return;
      if (window.scrollY > 400) {
        btn.classList.remove('opacity-0', 'translate-y-2');
        btn.classList.add('opacity-100', 'translate-y-0');
      } else {
        btn.classList.add('opacity-0', 'translate-y-2');
        btn.classList.remove('opacity-100', 'translate-y-0');
      }
    }, { passive: true });

    btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>
</BaseLayout>
