---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';
import { featuredCategories } from '../data/categories';

// Update this number as your subscriber count grows
const SUBSCRIBER_COUNT = '2,400+';

const SUBSCRIBE_URL = 'https://marketmattersonline.beehiiv.com/subscribe';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = sortedPosts.slice(0, 6);
const editorialPicks = sortedPosts.filter(p => p.data.featured).slice(0, 3);
const mostRead = sortedPosts.slice(0, 5); // swap for analytics-driven list once you have data
---

<BaseLayout
  title="Market Matters Online"
  description="Simple marketing tactics, AI tools, software reviews, and growth strategies for people who need results without the fluff."
>

  <!-- ============================================================
       HERO
  ============================================================ -->
  <section class="bg-slate-900 text-white pt-16 pb-20 lg:pt-20 lg:pb-28 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(37,99,235,0.15)_0%,_transparent_60%)] pointer-events-none"></div>
    <div class="site-container relative">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-blue-600/20 border border-blue-500/30 text-blue-300 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
          <span class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></span>
          Weekly Marketing Intelligence
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold leading-[1.05] tracking-tight mb-5">
          Marketing moves fast.<br>
          <span class="text-blue-400">We make it usable.</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 mb-8 max-w-2xl leading-relaxed">
          Simple marketing tactics, AI tools, software reviews, and growth strategies for people who need results without the fluff.
        </p>

        <!-- Newsletter CTA — hero -->
        <div class="mb-8">
          <a
            href={SUBSCRIBE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold text-sm hover:bg-blue-700 transition-colors"
          >
            Get the Brief →
          </a>
          <p class="text-slate-500 text-xs mt-2.5 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Join {SUBSCRIBER_COUNT} practical marketers. Free. No spam. Unsubscribe anytime.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a href="/start-here/" class="btn-ghost-white text-sm px-5 py-2.5">
            New here? Start Here →
          </a>
          <a href="/blog/" class="text-slate-400 hover:text-white text-sm font-medium transition-colors">
            Browse all posts
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       THIS WEEK'S EDITORIAL PICKS
  ============================================================ -->
  {editorialPicks.length > 0 && (
    <section class="bg-white border-b border-slate-200 section-pad-sm">
      <div class="site-container">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-3">
            <div class="w-1 h-8 bg-blue-600 rounded-full"></div>
            <div>
              <p class="text-xs font-bold text-blue-600 uppercase tracking-widest">Editorial Picks</p>
              <h2 class="text-xl font-bold text-slate-900">The Guides People Keep Coming Back To</h2>
            </div>
          </div>
          <a href="/start-here/" class="hidden sm:flex text-sm font-medium text-blue-600 hover:text-blue-700 items-center gap-1">
            Full Start Here guide →
          </a>
        </div>
        <div class="grid gap-5">
          {editorialPicks.map(post => (
            <PostCard post={post} variant="featured" />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================
       FIND WHAT YOU ACTUALLY NEED (Categories)
  ============================================================ -->
  <section class="section-pad bg-slate-50">
    <div class="site-container">
      <div class="flex items-center justify-between mb-8">
        <div>
          <p class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-1">Browse by topic</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Find What You Actually Need</h2>
          <p class="text-slate-600 mt-1">Pick your situation. We have a guide for it.</p>
        </div>
        <a href="/blog/" class="hidden sm:flex items-center gap-1 text-blue-600 hover:text-blue-700 font-medium text-sm">
          All posts →
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {featuredCategories.map(cat => (
          <CategoryCard category={cat} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       WHAT DROPPED THIS WEEK (Latest posts)
  ============================================================ -->
  <section class="section-pad bg-white">
    <div class="site-container">
      <div class="flex items-center justify-between mb-8">
        <div>
          <p class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-1">Fresh off the press</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">What Dropped This Week</h2>
          <p class="text-slate-600 mt-1">Tactics, breakdowns, and guides — updated regularly.</p>
        </div>
        <a href="/blog/" class="hidden sm:flex items-center gap-1 text-blue-600 hover:text-blue-700 font-medium text-sm">
          View all →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestPosts.map(post => (
          <PostCard post={post} />
        ))}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/blog/" class="btn-secondary">View all posts →</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       MOST READ (social proof + discovery)
  ============================================================ -->
  <section class="section-pad-sm bg-slate-50 border-y border-slate-200">
    <div class="site-container">
      <div class="flex flex-col lg:flex-row gap-10">
        <!-- Most read list -->
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-1 h-8 bg-emerald-500 rounded-full"></div>
            <div>
              <p class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Popular</p>
              <h2 class="text-xl font-bold text-slate-900">Most Read This Month</h2>
            </div>
          </div>
          <div>
            {mostRead.map((post, i) => (
              <a
                href={`/blog/${post.slug}/`}
                class="flex items-start gap-4 py-3.5 border-b border-slate-200 last:border-0 group"
              >
                <span class="text-2xl font-black text-slate-200 group-hover:text-blue-200 transition-colors leading-none mt-0.5 w-6 flex-shrink-0">
                  {i + 1}
                </span>
                <div>
                  <p class="font-semibold text-slate-800 text-sm leading-snug group-hover:text-blue-600 transition-colors">
                    {post.data.title}
                  </p>
                  <p class="text-xs text-slate-500 mt-1">{post.data.readTime ?? '5 min read'}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Newsletter sidebar CTA -->
        <div class="lg:w-80 flex-shrink-0">
          <div class="bg-slate-900 rounded-2xl p-6 text-white h-full flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold mb-2">Get it in your inbox</h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-5">
                One trend, one tactic, one tool — every week. Read in under 5 minutes.
              </p>
            </div>
            <div>
              <a
                href={SUBSCRIBE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition-colors text-center"
              >
                Subscribe Free →
              </a>
              <p class="text-slate-600 text-xs mt-2 text-center">Join {SUBSCRIBER_COUNT} marketers. No spam.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FREE DOWNLOAD CTA
  ============================================================ -->
  <section class="bg-slate-900 py-16">
    <div class="site-container">
      <div class="max-w-3xl mx-auto text-center">
        <div class="w-14 h-14 bg-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-5">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </div>
        <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-3">Free Download</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3">
          Local Marketing Quickstart Checklist
        </h2>
        <p class="text-slate-300 text-lg mb-8 max-w-xl mx-auto">
          The exact steps to get your local business found online — Google Business Profile, local SEO, and your first 10 leads.
        </p>
        <a href="/#newsletter" class="btn-primary text-base px-8 py-3.5">
          Download Free → (via newsletter)
        </a>
        <p class="text-slate-500 text-sm mt-3">Delivered instantly when you subscribe. No credit card.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SHOW ME RESULTS ONLY — Soft CTA
  ============================================================ -->
  <section class="section-pad bg-white border-b border-slate-200">
    <div class="site-container">
      <div class="max-w-3xl mx-auto bg-slate-50 rounded-2xl border border-slate-200 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center gap-6">
          <div class="flex-1">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Our Consulting Arm</span>
            <h2 class="text-2xl font-bold text-slate-900 mt-1 mb-3">
              Need help turning strategy into leads?
            </h2>
            <p class="text-slate-600 leading-relaxed">
              Show Me Results Only helps small businesses turn marketing ideas into measurable action — with real campaigns, real systems, and results you can actually track.
            </p>
          </div>
          <div class="flex-shrink-0">
            <a
              href="https://showmeresultsonly.com"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary whitespace-nowrap"
            >
              Visit ShowMeResultsOnly.com →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CLOSING POSITIONING
  ============================================================ -->
  <section class="py-10 bg-white">
    <div class="site-container text-center">
      <p class="text-slate-500 text-base max-w-xl mx-auto">
        Built for <strong class="text-slate-700">practical marketers</strong>, <strong class="text-slate-700">business owners</strong>, and <strong class="text-slate-700">teams</strong> who need smarter growth — without the noise.
      </p>
    </div>
  </section>

</BaseLayout>
